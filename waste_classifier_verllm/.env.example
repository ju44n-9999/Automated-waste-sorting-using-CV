LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Conservative demo defaults; verify your own Groq Console limits.
GROQ_MIN_INTERVAL_SECONDS=30
GROQ_MAX_CALLS_24H=75
# Optional: absolute file path for persistent rolling quota database.
# GROQ_QUOTA_PATH=
# Optional fallback: LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
IMAGE_DETAIL=low
# Applies to both Groq and OpenAI; firmware waits 60s including upload overhead.
OPENAI_TIMEOUT_SECONDS=45
MAX_IMAGE_BYTES=524288
MAX_IMAGE_PIXELS=2000000
# Mock never calls OpenAI. Fixed label does NOT detect object removal.
MOCK_MODE=true
MOCK_LABEL=unknown
# Optional shared LAN token; set the same value in firmware config.h.
DEVICE_TOKEN=
